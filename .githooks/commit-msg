#!/bin/sh
commit_message_file="$1"
first_line=$(sed -n '1p' "$commit_message_file")
pattern='^(feat|fix|docs|refactor|test|chore|build|ci|perf|style|revert): \[M[1-9][0-9]*\] - .+$'
if ! printf '%s\n' "$first_line" | grep -Eq "$pattern"; then
  cat >&2 <<'MSG'
Invalid commit message.
Use: <type>: [M<number>] - <description>
Example: feat: [M1] - add business metrics overview
MSG
  exit 1
fi
